{
  "name": "functions",
  "description": "TypeScript Express API & Cloud Functions for React-Collage-B",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "test": "vitest run",
    "deploy": "npm run build && firebase deploy --only functions"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "helmet": "^8.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.4.5",
    "vitest": "^2.0.0"
  },
  "private": true
}
