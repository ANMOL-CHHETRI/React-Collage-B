rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Is user logged in?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Does request UID match document ID?
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function: Check if user is Admin
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 1. Users Collection rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated(); // Allowed on sign-up
      // Users can modify profile fields, but cannot modify role, violations, or ban status
      allow update: if isOwner(userId) 
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'violations', 'banned'])
        || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Products Collection rules
    match /products/{productId} {
      allow read: if true; // Public catalog access
      allow create, update, delete: if isAdmin();
    }

    // 3. Reviews Collection rules
    match /reviews/{reviewId} {
      allow read: if true; // Public reviews access
      allow create: if isAuthenticated() 
        && request.resource.data.user_username == request.auth.token.email; // Bind creator identity
      allow update, delete: if isAdmin();
    }

    // 4. Orders Collection rules
    match /orders/{orderId} {
      // Users can only view their own orders
      allow read: if isAuthenticated() && (resource.data.username == request.auth.uid || isAdmin());
      // Authenticated users can place orders
      allow create: if isAuthenticated() && request.resource.data.username == request.auth.uid;
      // Only admins/sellers can update order statuses
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 5. Seller Applications rules
    match /seller_applications/{username} {
      allow read: if isAuthenticated() && (request.auth.uid == username || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == username;
      allow update, delete: if isAdmin();
    }

    // 6. Reported Avatars rules
    match /reported_avatars/{username} {
      allow read, write: if isAdmin();
    }

    // 7. Coupons rules
    match /coupons/{couponId} {
      allow read: if isAuthenticated(); // Authenticated users look up coupon percentages
      allow write: if isAdmin();
    }

    // 8. Contact Messages rules
    match /messages/{messageId} {
      allow create: if true; // Guest users can submit inquiries
      allow read, update, delete: if isAdmin();
    }
  }
}
