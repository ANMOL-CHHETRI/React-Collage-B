rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Is user logged in?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Does request UID or Email match document ID / owner?
    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        (resource != null && (
          resource.data.uid == request.auth.uid ||
          resource.data.email == request.auth.token.email ||
          resource.data.username == userId
        ))
      );
    }

    // Helper function: Check if user is Admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@shopease.com' ||
        request.auth.token.email == 'tallman@gmail.com' ||
        (resource != null && resource.data.role == 'admin') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 1. Users Collection rules
    match /users/{userId} {
      allow read, create, update, delete: if true;
    }

    // 2. Projects Collection rules
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // 3. Collages Collection rules
    match /collages/{collageId} {
      allow read, write: if true;

      // Images subcollection
      match /images/{imageId} {
        allow read, write: if true;
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read, write: if true;
      }

      // Reactions subcollection
      match /reactions/{reactionId} {
        allow read, write: if true;
      }
    }

    // 4. Products Collection rules
    match /products/{productId} {
      allow read, write: if true;
    }

    // 5. Reviews Collection rules
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // 6. Orders Collection rules
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // 7. Seller Applications rules
    match /sellerApplications/{appId} {
      allow read, write: if true;
    }

    // 8. Reported Avatars rules
    match /reportedAvatars/{reportId} {
      allow read, write: if true;
    }

    // 9. Coupons rules
    match /coupons/{couponId} {
      allow read, write: if true;
    }

    // 10. Messages rules
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // 11. Audit Logs rules
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // 12. Health check rules
    match /_health/{docId} {
      allow read, write: if true;
    }
  }
}
