rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Is user logged in?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Does request UID match document ID / owner?
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function: Check if user is Admin
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 1. Users Collection rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if (isOwner(userId) 
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'violations', 'banned']))
        || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Projects Collection rules
    match /projects/{projectId} {
      allow read: if resource.data.visibility == 'public' || isOwner(resource.data.ownerId) || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // 3. Collages Collection rules
    match /collages/{collageId} {
      allow read: if resource.data.visibility == 'public' || isOwner(resource.data.ownerId) || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.ownerId) || isAdmin();

      // Images subcollection
      match /images/{imageId} {
        allow read: if true;
        allow write, delete: if isAuthenticated();
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isOwner(resource.data.userId) || isAdmin();
      }

      // Reactions subcollection
      match /reactions/{reactionId} {
        allow read: if true;
        allow write, delete: if isAuthenticated();
      }
    }

    // 4. Products Collection rules
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 5. Reviews Collection rules
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 6. Orders Collection rules
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.username == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.username == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 7. Seller Applications rules
    match /sellerApplications/{appId} {
      allow read: if isAuthenticated() && (resource.data.username == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 8. Reported Avatars rules
    match /reportedAvatars/{reportId} {
      allow read, write: if isAdmin();
    }

    // 9. Coupons rules
    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 10. Messages rules
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
