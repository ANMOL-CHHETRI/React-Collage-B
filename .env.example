# ShopEase Environment Variables
# Copy to .env for local development

# Google OAuth Client Credentials
VITE_GOOGLE_CLIENT_ID=633391699225-qq38jdvn78oaf7pd4l92uj9542s2djhh.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Firebase Web App Configuration (Firebase Console -> Project Settings -> General -> Your Apps -> Web App)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Base Path (optional for dev, set to /React-Collage-B/ for GitHub Pages)
VITE_BASE_PATH=/
